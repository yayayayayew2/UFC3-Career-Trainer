    <CheatEntry>
      <ID>200</ID>
      <Description>"[2] UNLIMITED STAMINA — Fight Stamina Control"</Description>
      <Options moHideChildren="0"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>201</ID>
          <Description>"[Master Hook] Stamina Core Engine (Auto-Managed)"</Description>
          <Options moHideChildren="0"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(MC_HOOK,ucrtbase.dll,C3 8B 0A 89 08 C3 90)
alloc(MC_mem,$100,MC_HOOK)
alloc(MC_code,$200,MC_HOOK)
label(st_do_lock)
label(st_done)
registersymbol(MC_mem)
registersymbol(MC_HOOK)

// MC_mem layout:
// +00: Lock status (1 = ON, 0 = OFF)
// +04: Target side (1 = Left, 0 = Right, -1 = Both)
MC_mem:
  dd 1
  dd 1

MC_code:
  mov ecx,[rdx]
  pushfq
  // 1. Make sure the caller is the attribute function at 800098B47
  mov r10,800098B47
  cmp [rsp+48],r10
  jne st_done
  // 2. Make sure RBX == 0x20 (main stats buffer)
  cmp qword ptr [rsp+30],20
  jne st_done
  // 3. Make sure the float value is in the stamina range (15.0 to 100.0)
  cmp ecx,41700000
  jb st_done
  cmp ecx,42C80000
  ja st_done
  // 4. Check whether the lock is active
  cmp dword ptr [MC_mem],1
  jne st_done

  // Check the target fighter side
  cmp dword ptr [MC_mem+04],-1
  je st_do_lock
  cmp r13d,[MC_mem+04]
  jne st_done

st_do_lock:
  mov ecx,42C80000
  mov [rdx],ecx

st_done:
  popfq
  mov [rax],ecx
  ret

MC_HOOK+1:
  jmp MC_code

[DISABLE]
MC_HOOK+1:
  db 8B 0A 89 08 C3
unregistersymbol(MC_HOOK)
unregistersymbol(MC_mem)
dealloc(MC_mem)
dealloc(MC_code)
</AssemblerScript>
